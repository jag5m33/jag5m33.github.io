  "projects": [
    {
      "id": "acc",
      "label": "US Accidents",
      "repo": "jag5m33/py_acc",
      "branch": "main",
      "summary": "Which weather, time-of-day and road features predict whether a US road accident will be severe? 7.7 million accidents, staged EDA, feature engineering, decision tree and XGBoost classifiers, error analysis, and a Power BI dashboard.",
      "uses": [
        "descriptive",
        "quartiles",
        "hypothesis",
        "profiling",
        "vartypes",
        "unibimulti",
        "labelchecks",
        "cleaning",
        "features",
        "scaling",
        "clsmetrics",
        "biasvar"
      ],
      "code": [
        "src/decision_tree.py",
        "src/xgboost.py",
        "src/classification_error_analysis.py",
        "notebooks/eda.ipynb",
        "notebooks/model.ipynb",
        "notes.txt"
      ],
      "metrics": {
        "title": "Validation results",
        "columns": [
          "Model",
          "Precision",
          "Recall",
          "F1",
          "PR-AUC"
        ],
        "rows": [
          [
            "Baseline",
            "–",
            "–",
            "–",
            "0.340"
          ],
          [
            "Decision tree",
            "0.783",
            "0.689",
            "0.733",
            "0.822"
          ],
          [
            "XGBoost",
            "0.821",
            "0.763",
            "0.791",
            "0.871"
          ]
        ]
      },
      "results": [
        {
          "img": "https://raw.githubusercontent.com/jag5m33/py_acc/main/dashboard_viz/page_1.png",
          "caption": "Power BI dashboard, page 1"
        },
        {
          "img": "https://raw.githubusercontent.com/jag5m33/py_acc/main/dashboard_viz/page_2.png",
          "caption": "Power BI dashboard, page 2"
        },
        {
          "img": "https://raw.githubusercontent.com/jag5m33/py_acc/main/dashboard_viz/page_3.png",
          "caption": "Power BI dashboard, page 3"
        }
      ],
      "models": [
        {
          "id": "acc-tree",
          "label": "Decision tree",
          "topic": "trees",
          "summary": "Predicts whether an accident is severe (severity 3 or 4). The simple, explainable model, built first as the benchmark.",
          "points": [
            "Settings: max depth 10, at least 500 rows per leaf",
            "Road type carries 64% of the importance, then location (17%)",
            "Threshold 0.5, not tuned yet"
          ],
          "metrics": {
            "columns": [
              "Precision",
              "Recall",
              "F1",
              "PR-AUC"
            ],
            "rows": [
              [
                "0.783",
                "0.689",
                "0.733",
                "0.822"
              ]
            ]
          },
          "code": [
            "src/decision_tree.py",
            "notebooks/model.ipynb"
          ]
        },
        {
          "id": "acc-xgb",
          "label": "XGBoost",
          "topic": "xgboost",
          "summary": "Same task and features as the decision tree, but many small trees built one after another, each fixing the last one's mistakes.",
          "points": [
            "Default settings, threshold 0.5",
            "Beats the tree on every metric (PR-AUC 0.871 vs 0.822)",
            "Next: tune on validation, pick the threshold from the precision-recall curve"
          ],
          "metrics": {
            "columns": [
              "Precision",
              "Recall",
              "F1",
              "PR-AUC"
            ],
            "rows": [
              [
                "0.821",
                "0.763",
                "0.791",
                "0.871"
              ]
            ]
          },
          "code": [
            "src/xgboost.py",
            "notebooks/model.ipynb"
          ]
        }
      ]
    },
    {
      "id": "legal",
      "label": "Legal Clause NLP",
      "repo": "jag5m33/py_legal_data",
      "branch": "main",
      "summary": "Classify contract clauses into 100 types (LEDGAR / LexGLUE). Regex cleaning, spaCy lemmatisation, stop words, TF-IDF with n-grams, then two models on the same features: multiclass softmax logistic regression, and a Complement Naive Bayes model built for the imbalanced classes. Error analysis shows most mistakes are near-synonym labels.",
      "uses": [
        "descriptive",
        "profiling",
        "unibimulti",
        "labelchecks",
        "nlpterms",
        "tokenise",
        "stopwords",
        "bow",
        "ngrams",
        "tfidf",
        "clsmetrics",
        "regularisation",
        "biasvar"
      ],
      "code": [
        "src/clean.py",
        "src/lemmetizer.py",
        "src/tf_idf.py",
        "src/multi_class_lr_softmax.py",
        "src/complement_nb.py",
        "src/classification_error_analysis.py",
        "PIPELINE_NOTES.md",
        "notebooks/eda.ipynb",
        "notebooks/preprocess.ipynb",
        "notebooks/model_mcc.ipynb",
        "notebooks/model_nb.ipynb"
      ],
      "metrics": {
        "title": "Validation results, both models",
        "columns": [
          "Model",
          "Accuracy",
          "Macro F1"
        ],
        "rows": [
          [
            "Softmax logistic regression",
            "0.839",
            "0.780"
          ],
          [
            "Complement Naive Bayes (alpha 0.1)",
            "0.821",
            "0.716"
          ]
        ]
      },
      "results": [],
      "models": [
        {
          "id": "legal-lr",
          "label": "Softmax logistic regression",
          "short": "Logistic regression",
          "topic": "softmax",
          "summary": "Classifies each contract clause into one of 100 types from its TF-IDF features.",
          "points": [
            "Multinomial logistic regression, C = 1.0",
            "class_weight='balanced' for the imbalanced classes",
            "Most errors are near-synonym labels (Governing Laws vs Applicable Laws)"
          ],
          "metrics": {
            "columns": [
              "Split",
              "Accuracy",
              "Macro F1"
            ],
            "rows": [
              [
                "Train",
                "0.899",
                "0.887"
              ],
              [
                "Validation",
                "0.839",
                "0.780"
              ]
            ]
          },
          "code": [
            "src/multi_class_lr_softmax.py",
            "notebooks/model_mcc.ipynb"
          ]
        },
        {
          "id": "legal-nb",
          "label": "Complement Naive Bayes",
          "short": "Complement NB",
          "topic": "naivebayes",
          "summary": "Same saved TF-IDF features as the logistic regression, so the two compare fairly. Complement NB is the Naive Bayes version built for imbalanced classes.",
          "points": [
            "Started out underfitting, so I tested alpha from 1.0 down to 0.01",
            "Chose alpha = 0.1: validation macro F1 0.701 → 0.716",
            "Fast to train, but below logistic regression (0.780); error analysis next"
          ],
          "metrics": {
            "columns": [
              "Split",
              "Accuracy",
              "Macro F1"
            ],
            "rows": [
              [
                "Train",
                "0.890",
                "0.833"
              ],
              [
                "Validation",
                "0.821",
                "0.716"
              ]
            ]
          },
          "code": [
            "src/complement_nb.py",
            "notebooks/model_nb.ipynb"
          ]
        }
      ]
