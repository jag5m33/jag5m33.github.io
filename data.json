    {
      "id": "acc",
      "label": "US Accidents",
      "repo": "jag5m33/py_acc",
      "branch": "main",
      "summary": "Which weather, time-of-day and road features predict whether a US road accident will be severe? 7.7 million accidents, staged EDA, feature engineering, decision tree and XGBoost classifiers, error analysis, and a Power BI dashboard.",
      "uses": [
        "descriptive",
        "quartiles",
        "hypothesis",
        "profiling",
        "vartypes",
        "unibimulti",
        "labelchecks",
        "cleaning",
        "features",
        "scaling",
        "clsmetrics",
        "biasvar"
      ],
      "code": [
        "src/decision_tree.py",
        "src/xgboost.py",
        "src/classification_error_analysis.py",
        "notebooks/eda.ipynb",
        "notebooks/model.ipynb",
        "notes.txt"
      ],
      "metrics": {
        "title": "Validation results",
        "columns": [
          "Model",
          "Precision",
          "Recall",
          "F1",
          "PR-AUC"
        ],
        "rows": [
          [
            "Baseline",
            "–",
            "–",
            "–",
            "0.340"
          ],
          [
            "Decision tree",
            "0.783",
            "0.689",
            "0.733",
            "0.822"
          ],
          [
            "XGBoost",
            "0.821",
            "0.763",
            "0.791",
            "0.871"
          ]
        ]
      },
      "results": [
