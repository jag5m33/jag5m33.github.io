      "id": "legal",
      "label": "Legal Clause NLP",
      "repo": "jag5m33/py_legal_data",
      "branch": "main",
      "summary": "Classify contract clauses into 100 types (LEDGAR / LexGLUE). Regex cleaning, spaCy lemmatisation, stop words, TF-IDF with n-grams, then two models on the same features: multiclass softmax logistic regression, and a Complement Naive Bayes model (in progress) built for the imbalanced classes. Error analysis shows most mistakes are near-synonym labels.",
      "uses": [
        "descriptive",
        "profiling",
        "unibimulti",
        "labelchecks",
        "nlpterms",
        "tokenise",
        "stopwords",
        "bow",
        "ngrams",
        "tfidf",
        "clsmetrics",
        "regularisation",
        "biasvar"
      ],
      "code": [
