    {
      "id": "elec",
      "label": "GB Grid Anomalies",
      "repo": "jag5m33/py_elec_grid_anomaly",
      "branch": "main",
      "summary": "Finding half-hours when GB national electricity demand (NESO, 2018–2023) is unusually high or low for its time of day and week. MSTL strips out the normal daily and weekly pattern, then an isolation forest flags the half-hours left over that don't fit.",
      "uses": [
        "descriptive",
        "distributions",
        "profiling",
        "vartypes",
        "cleaning",
        "features",
        "autocorr",
        "isoforest"
      ],
      "code": [
        "notebooks/eda.ipynb",
        "src/mstl.py",
        "notebooks/model.ipynb"
      ],
      "results": [],
      "models": [
        {
          "id": "elec-mstl",
          "label": "MSTL baseline",
          "topic": "autocorr",
          "summary": "Splits half-hourly demand into trend + daily pattern + weekly pattern + residual. What's left (the residual) is demand the normal patterns can't explain.",
          "points": [
            "Periods 48 (one day of half-hours) and 336 (one week)",
            "robust=True so big events (Covid, Christmas) don't bend the 'normal' pattern",
            "The residuals feed the anomaly detector"
          ],
          "code": [
            "src/mstl.py",
            "notebooks/model.ipynb"
          ]
        },
        {
          "id": "elec-iso",
          "label": "Isolation forest",
          "topic": "isoforest",
          "summary": "Runs on the MSTL residuals and flags half-hours that are easy to isolate, i.e. unusual for their time of day and week.",
          "points": [
            "Results going up once the notebook is pushed"
          ],
          "code": [
            "notebooks/model.ipynb"
          ]
        }
      ]
    }
