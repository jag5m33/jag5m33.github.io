        "src/classification_error_analysis.py",
        "PIPELINE_NOTES.md",
        "notebooks/eda.ipynb",
        "notebooks/preprocess.ipynb",
        "notebooks/model_mcc.ipynb",
        "notebooks/model_nb.ipynb"
