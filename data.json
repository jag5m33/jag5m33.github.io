  "mlops": {
    "id": "mlops",
    "label": "MLOps",
    "summary": "The tools I use to track, explain and ship models. Each one links to the projects where I've used it; the faded ones are what I'm learning next.",
    "tools": [
      {
        "id": "mlflow",
        "label": "MLflow",
        "what": "Experiment tracking: records every training run's settings, scores and saved model, so runs can be compared side by side and the best one reloaded.",
        "used": [
          {
            "project": "legal",
            "note": "17 tracked runs: a C sweep for logistic regression and an alpha × norm sweep for Complement NB, with both final models logged.",
            "code": [
              "notebooks/models.ipynb",
              "mlflow.db"
            ]
          }
        ]
      },
      {
        "id": "shap",
        "label": "SHAP",
