  "projects": [
    {
      "id": "acc",
      "label": "US Accidents",
      "repo": "jag5m33/py_acc",
      "branch": "main",
      "summary": "Which weather, time-of-day and road features predict whether a US road accident will be severe? 7.7 million accidents, staged EDA, feature engineering, decision tree and XGBoost classifiers, error analysis, and a Power BI dashboard.",
      "uses": [
        "descriptive",
        "quartiles",
        "hypothesis",
        "profiling",
        "vartypes",
        "unibimulti",
        "labelchecks",
        "cleaning",
        "features",
        "scaling",
        "clsmetrics",
        "biasvar"
      ],
      "code": [
        "src/decision_tree.py",
        "src/xgboost.py",
        "src/classification_error_analysis.py",
        "notebooks/eda.ipynb",
        "notebooks/model.ipynb",
        "notes.txt"
      ],
      "metrics": {
        "title": "Validation results",
        "columns": [
          "Model",
          "Precision",
          "Recall",
          "F1",
          "PR-AUC"
        ],
        "rows": [
          [
            "Baseline",
            "–",
            "–",
            "–",
            "0.340"
          ],
          [
            "Decision tree",
            "0.783",
            "0.689",
            "0.733",
            "0.822"
          ],
          [
            "XGBoost",
            "0.821",
            "0.763",
            "0.791",
            "0.871"
          ]
        ]
      },
      "results": [
        {
          "img": "https://raw.githubusercontent.com/jag5m33/py_acc/main/dashboard_viz/page_1.png",
          "caption": "Power BI dashboard, page 1"
        },
        {
          "img": "https://raw.githubusercontent.com/jag5m33/py_acc/main/dashboard_viz/page_2.png",
          "caption": "Power BI dashboard, page 2"
        },
        {
          "img": "https://raw.githubusercontent.com/jag5m33/py_acc/main/dashboard_viz/page_3.png",
          "caption": "Power BI dashboard, page 3"
        }
      ],
      "models": [
        {
          "id": "acc-tree",
          "label": "Decision tree",
          "topic": "trees",
          "summary": "Predicts whether an accident is severe (severity 3 or 4). The simple, explainable model, built first as the benchmark.",
          "points": [
            "Settings: max depth 10, at least 500 rows per leaf",
            "Road type carries 64% of the importance, then location (17%)",
            "Threshold 0.5, not tuned yet"
          ],
          "metrics": {
            "columns": [
              "Precision",
              "Recall",
              "F1",
              "PR-AUC"
            ],
            "rows": [
              [
                "0.783",
                "0.689",
                "0.733",
                "0.822"
              ]
            ]
          },
          "code": [
            "src/decision_tree.py",
            "notebooks/model.ipynb"
          ]
        },
        {
          "id": "acc-xgb",
          "label": "XGBoost",
          "topic": "xgboost",
          "summary": "Same task and features as the decision tree, but many small trees built one after another, each fixing the last one's mistakes.",
          "points": [
            "Default settings, threshold 0.5",
            "Beats the tree on every metric (PR-AUC 0.871 vs 0.822)",
            "Next: tune on validation, pick the threshold from the precision-recall curve"
          ],
          "metrics": {
            "columns": [
              "Precision",
              "Recall",
              "F1",
              "PR-AUC"
            ],
            "rows": [
              [
                "0.821",
                "0.763",
                "0.791",
                "0.871"
              ]
            ]
          },
          "code": [
            "src/xgboost.py",
            "notebooks/model.ipynb"
          ]
        }
      ]
    },
    {
      "id": "legal",
      "label": "Legal Clause NLP",
      "repo": "jag5m33/py_legal_data",
      "branch": "main",
      "summary": "Classify contract clauses into 100 types (LEDGAR / LexGLUE). Regex cleaning, spaCy lemmatisation, stop words and TF-IDF with n-grams are run once and saved; then two models train on the same features: multiclass softmax logistic regression and Complement Naive Bayes. One shared evaluator scores every model the same way. Error analysis shows most mistakes are near-synonym labels.",
      "uses": [
        "descriptive",
        "profiling",
        "unibimulti",
        "labelchecks",
        "nlpterms",
        "tokenise",
        "stopwords",
        "bow",
        "ngrams",
        "tfidf",
        "clsmetrics",
        "regularisation",
        "biasvar"
      ],
      "code": [
        "src/clean.py",
        "src/lemmetizer.py",
        "src/tf_idf.py",
        "src/models.py",
        "src/sup_eval_metrics.py",
        "src/classification_error_analysis.py",
        "PIPELINE_NOTES.md",
        "mlflow.db",
        "notebooks/eda.ipynb",
        "notebooks/preprocess.ipynb",
        "notebooks/models.ipynb"
      ],
      "metrics": {
        "title": "Validation results, both models",
        "columns": [
          "Model",
          "Accuracy",
          "Macro F1"
        ],
        "rows": [
          [
            "Softmax logistic regression (C = 10)",
            "0.869",
            "0.811"
          ],
          [
            "Complement Naive Bayes (alpha 0.1)",
            "0.821",
            "0.716"
          ]
        ]
      },
      "results": [],
      "models": [
        {
          "id": "legal-lr",
          "label": "Softmax logistic regression",
          "short": "Logistic regression",
          "topic": "softmax",
          "summary": "Classifies each contract clause into one of 100 types from its TF-IDF features.",
          "points": [
            "Multinomial logistic regression, class_weight='balanced'",
            "Tuned C with MLflow (0.1, 1, 10, 30): chose C = 10, since 30 added only 0.4 points",
            "Still overfits (gap 0.175). Lowering C shrank the gap but cost validation F1 (0.705 at C = 0.1), so regularisation alone doesn't fix it",
            "74% of Applicable Laws clauses are choice-of-law clauses worded like Governing Laws: label overlap, not just model error",
            "Trigrams (1,3) cut the Waivers / No Waivers confusion"
          ],
          "metrics": {
            "columns": [
              "Split",
              "Accuracy",
              "Macro F1"
            ],
            "rows": [
              [
                "Train",
                "0.985",
                "0.986"
              ],
              [
                "Validation",
                "0.869",
                "0.811"
              ]
            ]
          },
          "code": [
            "src/models.py",
            "src/sup_eval_metrics.py",
            "notebooks/models.ipynb"
          ]
        },
        {
          "id": "legal-nb",
          "label": "Complement Naive Bayes",
          "short": "Complement NB",
          "topic": "naivebayes",
          "summary": "Same saved TF-IDF features as the logistic regression, so the two compare fairly. Complement NB is the Naive Bayes version built for imbalanced classes.",
          "points": [
            "Started out underfitting, so I tested alpha from 1.0 down to 0.01, with and without norm",
            "Chose alpha = 0.1, norm off: validation macro F1 0.701 → 0.716; norm made no real difference",
            "Training error stayed ~16%, so the gap to logistic regression (0.780) is model bias, not tuning"
          ],
          "metrics": {
            "columns": [
              "Split",
              "Accuracy",
              "Macro F1"
            ],
            "rows": [
              [
                "Train",
                "0.890",
                "0.833"
              ],
              [
                "Validation",
                "0.821",
                "0.716"
              ]
            ]
          },
          "code": [
            "src/models.py",
            "src/sup_eval_metrics.py",
            "notebooks/models.ipynb"
          ]
        }
      ]
    },
    {
      "id": "elec",
      "label": "GB Grid Anomalies",
      "repo": "jag5m33/py_elec_grid_anomaly",
      "branch": "main",
      "summary": "Finding half-hours when GB national electricity demand (NESO, 2018–2023) is unusually high or low for its time of day and week. MSTL strips out the normal daily and weekly pattern, then an isolation forest flags the half-hours left over that don't fit.",
      "uses": [
        "descriptive",
        "distributions",
        "profiling",
        "vartypes",
        "cleaning",
        "features",
        "autocorr",
        "isoforest"
      ],
      "code": [
        "notebooks/eda.ipynb",
        "src/mstl.py",
        "notebooks/model.ipynb"
      ],
      "results": [],
      "models": [
        {
          "id": "elec-mstl",
          "label": "MSTL baseline",
          "topic": "autocorr",
          "summary": "Splits half-hourly demand into trend + daily pattern + weekly pattern + residual. What's left (the residual) is demand the normal patterns can't explain.",
          "points": [
            "Periods 48 (one day of half-hours) and 336 (one week)",
            "robust=True so big events (Covid, Christmas) don't bend the 'normal' pattern",
            "The residuals feed the anomaly detector"
          ],
          "code": [
            "src/mstl.py",
            "notebooks/model.ipynb"
          ]
        },
        {
          "id": "elec-iso",
          "label": "Isolation forest",
          "topic": "isoforest",
          "summary": "Runs on the MSTL residuals and flags half-hours that are easy to isolate, i.e. unusual for their time of day and week.",
          "points": [
            "Results going up once the notebook is pushed"
          ],
          "code": [
            "notebooks/model.ipynb"
          ]
        }
      ]
    }
